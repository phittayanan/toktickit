DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/toktickit_dev?schema=public"
PORT=4000
# The one browser origin the API accepts (CORS and the Origin check).
# Defaults to http://localhost:5173 when unset.
CLIENT_ORIGIN=
# Local-disk Attachment storage directory (specification.md §3). Defaults
# to server/uploads when unset or empty.
UPLOAD_DIR=
